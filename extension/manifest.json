{
  "manifest_version": 3,
  "name": "X Blocker",
  "short_name": "X Blocker",
  "version": "0.1.1",
  "description": "Mass-block X (Twitter) accounts from followers, likes, replies or imported lists. Review first, rate-limited, private.",
  "homepage_url": "https://github.com/bitcooker/x-blocker",
  "browser_specific_settings": {
    "gecko": {
      "id": "x-blocker@bitcooker",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "webRequest",
    "webRequestBlocking",
    "webRequestFilterResponse"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://api.x.com/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*"
      ],
      "js": [
        "content/main-world.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://x.com/*"
      ],
      "js": [
        "content/bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://x.com/*"
      ],
      "js": [
        "content/page-ui.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "X Blocker",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "dashboard/dashboard.html",
    "open_in_tab": true
  }
}
