{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "X Blocker",
  "version": "0.5.2",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "homepage_url": "https://github.com/bitcooker/x-blocker",
  "browser_specific_settings": {
    "gecko": {
      "id": "x-blocker@bitcooker",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "alarms",
    "unlimitedStorage",
    "webRequest",
    "webRequestBlocking",
    "webRequestFilterResponse"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://api.x.com/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*"
      ],
      "js": [
        "content/main-world.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://x.com/*"
      ],
      "js": [
        "content/bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://x.com/*"
      ],
      "js": [
        "ui/tokens.js",
        "ui/i18n.js",
        "locales/en.js",
        "locales/ar.js",
        "locales/de.js",
        "locales/es.js",
        "locales/fa.js",
        "locales/fr.js",
        "locales/ja.js",
        "locales/ko.js",
        "locales/tr.js",
        "locales/zh.js",
        "content/page-ui.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "__MSG_extName__",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "dashboard/dashboard.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/Vazirmatn-NL.woff2"
      ],
      "matches": [
        "https://x.com/*"
      ]
    }
  ]
}
