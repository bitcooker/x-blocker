{
  "name": "x-blocker",
  "version": "0.1.0",
  "private": true,
  "description": "Firefox extension to mass-block accounts on x.com",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "lint": "web-ext lint --source-dir extension",
    "start": "web-ext run --source-dir extension --target firefox-desktop --start-url https://x.com/home",
    "build": "web-ext build --source-dir extension --artifacts-dir dist --overwrite-dest"
  },
  "devDependencies": {
    "web-ext": "^8.10.0"
  }
}
